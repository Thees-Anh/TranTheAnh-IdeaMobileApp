<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 companion widget: pet + mood, Food/Water, then streak · done today · left today. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_background">

    <!-- Header: portrait, name, level · mood, refresh -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <FrameLayout android:layout_width="42dp" android:layout_height="42dp">
            <ImageView android:id="@+id/widget_pet" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter" android:src="@drawable/pawquest_portrait_cat_normal" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/widget_mood_icon" android:layout_width="16dp" android:layout_height="16dp"
                android:layout_gravity="bottom|end" android:src="@drawable/widget_mood_happy" android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="2dp">
            <TextView android:id="@+id/widget_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/app_name" android:textColor="@color/widget_text" android:textStyle="bold" android:textSize="14sp"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_mood" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_sign_in" android:textColor="@color/widget_muted" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageView android:id="@+id/widget_refresh" android:layout_width="32dp" android:layout_height="32dp" android:padding="6dp"
            android:src="@drawable/widget_ic_refresh" android:contentDescription="@string/widget_refresh" />
    </LinearLayout>

    <!-- Food and Water side by side -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginEnd="6dp">
            <TextView android:id="@+id/widget_hunger_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_food_unknown" android:textColor="@color/widget_text" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/widget_hunger" style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="3dp" android:max="100"
                android:progressDrawable="@drawable/widget_progress_food" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginStart="6dp">
            <TextView android:id="@+id/widget_water_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_water_unknown" android:textColor="@color/widget_text" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/widget_water" style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="3dp" android:max="100"
                android:progressDrawable="@drawable/widget_progress_water" />
        </LinearLayout>
    </LinearLayout>

    <!-- Metrics: streak · done today · left today (tap opens Quests) -->
    <LinearLayout android:id="@+id/widget_quests" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:minHeight="48dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:paddingTop="5dp" android:paddingBottom="5dp"
            android:background="@drawable/widget_tile">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/widget_ic_streak"
                    android:importantForAccessibility="no" />
                <TextView android:id="@+id/widget_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingStart="3dp" android:paddingEnd="0dp" android:textColor="@color/widget_text" android:textStyle="bold"
                    android:textSize="15sp" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/widget_streak_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textColor="@color/widget_muted" android:textSize="10sp"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="5dp" android:layout_marginEnd="5dp"
            android:orientation="vertical" android:gravity="center" android:paddingTop="5dp" android:paddingBottom="5dp"
            android:background="@drawable/widget_tile">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/widget_ic_done"
                    android:importantForAccessibility="no" />
                <TextView android:id="@+id/widget_done" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingStart="3dp" android:paddingEnd="0dp" android:textColor="@color/widget_text" android:textStyle="bold"
                    android:textSize="15sp" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/widget_done_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textColor="@color/widget_muted" android:textSize="10sp"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:paddingTop="5dp" android:paddingBottom="5dp"
            android:background="@drawable/widget_tile">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/widget_ic_left"
                    android:importantForAccessibility="no" />
                <TextView android:id="@+id/widget_left" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingStart="3dp" android:paddingEnd="0dp" android:textColor="@color/widget_text" android:textStyle="bold"
                    android:textSize="15sp" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/widget_left_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textColor="@color/widget_muted" android:textSize="10sp"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:gravity="center" android:text="@string/widget_open_app"
        android:textColor="@color/widget_muted" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
